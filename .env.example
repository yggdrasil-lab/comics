# Core Domain Configuration
DOMAIN_NAME=example.com

# Suwayomi admin auth (downloader web UI is admin-only; injected via GitHub Actions, not .env)
SUWAYOMI_AUTH_USERNAME=your_username_here
SUWAYOMI_AUTH_PASSWORD=your_password_here

# Komga OIDC (Authentik) — client-id/client-secret from the Authentik provider.
KOMGA_OIDC_CLIENT_ID=your_client_id_here
KOMGA_OIDC_CLIENT_SECRET=your_client_secret_here
